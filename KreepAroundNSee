				if Distance <= (AssistCfg['Max Range'] or 750) then
					local TargetPos, _ = ResolveHitPosition(TargetChar, AssistCfg);
					if not TargetPos then TargetPos = HumanoidRootPart.Position end;
					TargetPos = ApplyPrediction(TargetPos, AssistTarget, AssistCfg);

					local CamPos = CurrentCamera.CFrame.Position;
					local DesiredCFrame = CFrameNew(CamPos, TargetPos);

					local InterpCfg = AssistCfg['Smoothness'];
					if InterpCfg and InterpCfg['Enabled'] then
						local PosAlpha = InterpCfg['Smoothness'][1] or 0.1;
						local RotAlpha = InterpCfg['Smoothness'][2] or 0.1;

						local LerpedPos = CurrentCamera.CFrame.Position:Lerp(DesiredCFrame.Position, PosAlpha);
						local LerpedRot = CurrentCamera.CFrame:Lerp(DesiredCFrame, RotAlpha);
						CurrentCamera.CFrame = CFrameNew(LerpedPos) * (LerpedRot - LerpedRot.Position);
					else
						CurrentCamera.CFrame = DesiredCFrame;
					end;
				end;
			end;
		end;
	end;
end));

local function RageFire(Child, Handle, ToolName, Origin, Direction, GunRange, SpreadWeapons)
	if ShotgunWeapons[ToolName] then
		local ServerTime = Workspace:GetServerTimeNow();
		local SpreadMult = 1;
		if SpreadWeapons then
			local WeaponSpread = SpreadWeapons[ToolName];
			if WeaponSpread then SpreadMult = WeaponSpread['Multiplier'] or 1 end;
		end;
		for _ = 1, 5 do
			local SpreadX = (MathRandom() > 0.5 and MathRandom() * 0.05 or -MathRandom() * 0.05) * SpreadMult;
			local SpreadY = (MathRandom() > 0.5 and MathRandom() * 0.1 or -MathRandom() * 0.1) * SpreadMult;
			local SpreadZ = (MathRandom() > 0.5 and MathRandom() * 0.05 or -MathRandom() * 0.05) * SpreadMult;
			local AimDir = Direction + Vector3New(SpreadX, SpreadY, SpreadZ);
			local RayVec = AimDir * GunRange;
			local RayResult = Workspace:Raycast(Origin, RayVec, RageRayParams);
			CachedMainEvent:FireServer('ShootGun', Handle, Origin, RayResult and RayResult.Position or (Origin + RayVec), RayResult and RayResult.Instance, RayResult and RayResult.Normal, ServerTime);
		end;
	else
		local RayVec = Direction * GunRange;
		local RayResult = Workspace:Raycast(Origin, RayVec, RageRayParams);
		CachedMainEvent:FireServer('ShootGun', Handle, Origin, RayResult and RayResult.Position or (Origin + RayVec), RayResult and RayResult.Instance, RayResult and RayResult.Normal);
	end;
end;

local RageCore = LPH_JIT_MAX(function()
	local SilentAimCfg = Config['Silent Aim'];
	local RageCfg = SilentAimCfg['Rage'];
	if not RageCfg or RageCfg[1] ~= true or not SilentAimCfg['Enabled'] then
		State.RageStatus = 'Disabled';
		return;
	end;
	local Target = State.Targets.Silent;
	if not Target then
		State.RageStatus = 'No Target';
		return;
	end;
	local Character = LocalPlayer.Character;
	if not Character then
		State.RageStatus = 'No Character';
		return;
	end;
	local CharHRP = Character:FindFirstChild('HumanoidRootPart');
	if not CharHRP then
		State.RageStatus = 'Dead';
		return;
	end;
	if not CanShootCheck(Character) then
		State.RageStatus = 'Blocked';
		return;
	end;
	if not PassesConditions(Target) then
		State.RageStatus = 'Conditions';
		return;
	end;
	local TargetChar = Target.Character;
	if not TargetChar then
		State.RageStatus = 'No Character';
		return;
	end;
	local Hitbox = TargetChar:FindFirstChild('Head');
	if not Hitbox then
		State.RageStatus = 'Dead';
		return;
	end;

	local HitPartCfg = SilentAimCfg['Hit Part'];
	if type(HitPartCfg) == 'table' and HitPartCfg['Selection'] == 'Named Part' then
		local NamedPart = HitPartCfg['Named Part'] or (HitPartCfg['Override'] and HitPartCfg['Override']['Part']) or 'HumanoidRootPart';
		local Named = TargetChar:FindFirstChild(NamedPart);
		if Named then Hitbox = Named end;
	elseif type(HitPartCfg) == 'table' and HitPartCfg['Selection'] ~= 'Nearest Point' and HitPartCfg['Selection'] ~= 'Nearest Part' and HitPartCfg['Selection'] ~= 'Multi' then
		local Named = TargetChar:FindFirstChild(HitPartCfg['Selection']);
		if Named then Hitbox = Named end;
	elseif type(HitPartCfg) == 'table' and HitPartCfg['Selection'] == 'Multi' then
		local MultiCfg = HitPartCfg['Multi'];
		if MultiCfg and MultiCfg['Enabled'] then
			local Pos, Part = ResolveMultiPart(TargetChar, MultiCfg);
			if Part then Hitbox = Part end;
		end;
	elseif HitPartCfg and HitPartCfg['Mode'] == 'Named Part' then
		local Named = TargetChar:FindFirstChild(HitPartCfg['Part Name'] or 'HumanoidRootPart');
		if Named then Hitbox = Named end;
	end;

	local AimPos = ApplyPrediction(Hitbox.Position, Target, SilentAimCfg);
	local FallbackOrigin = CharHRP.Position;

	if not CachedMainEvent then CachedMainEvent = ReplicatedStorage:FindFirstChild('MainEvent') end;
	if not CachedMainEvent then return end;

	RageRayParams.FilterDescendantsInstances = BuildFilter(RageFilter, Character);

	local Now = Clock();
	local GunModsCfg = Config['Gun Modifications'];
	local DelayCfg = GunModsCfg['Delay Changer'];
	local DelayEnabled = DelayCfg['Enabled'];
	local DelayWeapons = DelayEnabled and DelayCfg['Weapons'];
	local SpreadCfg = GunModsCfg['Spread Modifications'];
	local SpreadEnabled = SpreadCfg['Enabled'];
	local SpreadWeapons = SpreadEnabled and SpreadCfg['Weapons'];

	local HasGun = false;
	local DidShoot = false;
	for _, Child in next, Character:GetChildren() do
		if not Child:IsA('Tool') then continue end;
		local ToolName = Child.Name;
		if not MuzzleOffsets[ToolName] then continue end;
		local Handle = Child:FindFirstChild('Handle');
		if not Handle then continue end;
		local Ammo = Child:FindFirstChild('Ammo');
		if not Ammo or Ammo.Value <= 0 then continue end;
		HasGun = true;

		local CD = Child:FindFirstChild('ShootingCooldown');
		local OrigCooldown = CD and CD.Value or 0.3;
		local Cooldown = OrigCooldown;
		if DelayWeapons then
			local WeaponDelay = DelayWeapons[ToolName];
			if WeaponDelay then Cooldown = WeaponDelay['Value'] or Cooldown end;
		end;
		if RageLastFire[Child] and (Now - RageLastFire[Child]) < MathMax(Cooldown, 0.006) then continue end;

		local RangeVal = Child:FindFirstChild('Range');
		local GunRange = RangeVal and RangeVal.Value or 200;

		local Origin = GetMuzzlePosition(Child) or FallbackOrigin;
		local AimOffset = AimPos - Origin;
		local AimDist = AimOffset.Magnitude;
		if AimDist <= 0 or AimDist > GunRange + 15 then continue end;
		local Direction = AimOffset / AimDist;

		for Burst = 1, 3 do
			if Ammo.Value <= 0 then break end;
			RageLastFire[Child] = Clock();
			RageFire(Child, Handle, ToolName, Origin, Direction, GunRange, SpreadWeapons);
		end;
		DidShoot = true;

		if not RageLastVisual[Child] or (Now - RageLastVisual[Child]) >= OrigCooldown then
			RageLastVisual[Child] = Now;
			Spawn(ShowPellet, Character, Handle, Origin, AimPos, GunRange);
		end;
	end;
	if DidShoot then
		State.RageStatus = 'Shooting';
	elseif HasGun then
		State.RageStatus = 'Out of Range';
	else
		State.RageStatus = 'No Gun';
	end;
end);

