			return false;
		end;
	end;

	if Conds['Player Grabbed'] then
		if CurrentGame.Grabbed(Player) then
			return false;
		end;
	end;

	if Conds['Player In Vehicle'] then
		if Humanoid and Humanoid.Sit then
			return false;
		end;
	end;

	if Conds['Player Blocking'] then
		local Block = Character:FindFirstChild('Block');
		if Block and Block:IsA('BoolValue') and Block.Value == true then
			return false;
		end;
	end;

	if Conds['Player Moving'] then
		local HumanoidRootPart = Character:FindFirstChild('HumanoidRootPart');
		if HumanoidRootPart then
			local Vel = HumanoidRootPart.AssemblyLinearVelocity;
			local Speed = Vector3New(Vel.X, 0, Vel.Z).Magnitude;
			if Speed < 1 then
				return false;
			end;
		end;
	end;

	if Conds['Player Visible'] then
		local HumanoidRootPart = Character:FindFirstChild('HumanoidRootPart');
		if HumanoidRootPart and not IsVisible(HumanoidRootPart.Position, Player) then
			return false;
		end;
	end;

	if Conds['Tool Equipped'] then
		local MyChar = LocalPlayer.Character;
		if MyChar and not MyChar:FindFirstChildOfClass('Tool') then
			return false;
		end;
	end;

	if Conds['Self Knocked'] then
		if CurrentGame.Knocked(LocalPlayer) then
			return false;
		end;
	end;

	if Conds['Chat Typing'] then
		if IsTyping() then
			return false;
		end;
	end;

	if Conds['Crew Check'] then
		if IsCrew(Player) then
			return false;
		end;
	end;

	return true;
end);

local function CleanScripts(Tool)
	if not Tool then return end;
	for _, Descendant in next, Tool:GetDescendants() do
		if Descendant:IsA('LocalScript') then
			Descendant:Destroy();
		end;
	end;
	Tool.DescendantAdded:Connect(function(Desc)
		if Desc:IsA('LocalScript') then
			Desc:Destroy();
		end;
	end);
end;

if CurrentGame.Name == 'Da Hood' then
	local function WatchCharacter(Character)
		if not Character then return end;
		for _, Child in next, Character:GetChildren() do
			if Child:IsA('Tool') then CleanScripts(Child) end;
		end;
		Character.ChildAdded:Connect(function(Child)
			if Child:IsA('Tool') then
				CleanScripts(Child);
				Defer(CleanScripts, Child);
			end;
		end);
	end;
	if LocalPlayer.Character then WatchCharacter(LocalPlayer.Character) end;
	LocalPlayer.CharacterAdded:Connect(WatchCharacter);
end;

