local ResolveMultiPart = LPH_NO_VIRTUALIZE(function(TargetChar, MultiCfg)
	local Preset = MultiCfg['Preset'];
	local Parts = (Preset ~= 'Custom' and MultiPresets[Preset]) or MultiCfg['Parts'];
	if not Parts or #Parts == 0 then return nil, nil end;
	local Mode = MultiCfg['Mode'] or 'Cycle';
	local MS = State.MultiHitPart;

	if Mode == 'Dynamic' then
		local DynCfg = MultiCfg['Dynamic'] or {};
		local HeadPriority = DynCfg['Head Priority'];
		local PreferVisible = DynCfg['Prefer Visible'];
		local PreferClosest = DynCfg['Prefer Closest'];

		if HeadPriority then
			local Head = TargetChar:FindFirstChild('Head');
			if Head then
				if not PreferVisible then return Head.Position, Head end;
				local Origin = Workspace.CurrentCamera.CFrame.Position;
				local Dir = (Head.Position - Origin);
				local Params = RaycastParams.new();
				Params.FilterType = Enum.RaycastFilterType.Exclude;
				Params.FilterDescendantsInstances = {TargetChar, Workspace.CurrentCamera, CachedIgnored, CachedBush};
				local Result = Workspace:Raycast(Origin, Dir, Params);
				if not Result then return Head.Position, Head end;
			end;
		end;

		local BestPart, BestScore = nil, MathHuge;
		local MousePos = UserInputService:GetMouseLocation();
		local Cam = Workspace.CurrentCamera;
		for _, PartName in next, Parts do
			local Part = TargetChar:FindFirstChild(PartName);
			if not Part then continue end;
			if PreferVisible then
				local Origin = Cam.CFrame.Position;
				local Dir = (Part.Position - Origin);
				local Params = RaycastParams.new();
				Params.FilterType = Enum.RaycastFilterType.Exclude;
				Params.FilterDescendantsInstances = {TargetChar, Workspace.CurrentCamera, CachedIgnored, CachedBush};
				local Result = Workspace:Raycast(Origin, Dir, Params);
				if Result then continue end;
			end;
			if PreferClosest then
				local ScreenPos, OnScreen = Cam:WorldToViewportPoint(Part.Position);
				if not OnScreen then continue end;
				local Dist = (MousePos - Vector2New(ScreenPos.X, ScreenPos.Y)).Magnitude;
				if Dist < BestScore then BestScore = Dist; BestPart = Part end;
			else
				BestPart = Part;
				break;
			end;
		end;
		if BestPart then
			MS.LastPart = BestPart.Name;
			return BestPart.Position, BestPart;
		end;

	elseif Mode == 'Cycle' then
		local CycleSpeed = MultiCfg['Cycle Speed'] or 1;
		local NoRepeat = MultiCfg['No Repeat'];
		MS.ShotCount = MS.ShotCount + 1;
		if MS.ShotCount >= CycleSpeed then
			MS.ShotCount = 0;
			MS.Index = MS.Index + 1;
			if MS.Index > #Parts then MS.Index = 1 end;
		end;
		local PartName = Parts[MS.Index];
		if NoRepeat and PartName == MS.LastPart and #Parts > 1 then
			MS.Index = MS.Index + 1;
			if MS.Index > #Parts then MS.Index = 1 end;
			PartName = Parts[MS.Index];
		end;
		if not PartName then return nil, nil end;
		local Part = TargetChar:FindFirstChild(PartName);
		if Part then
			MS.LastPart = PartName;
			return Part.Position, Part;
		end;
	end;

	return nil, nil;
end);

local PerWeaponCategories = { 'Shotguns', 'Pistols', 'Others' };

local ResolvePerWeaponCfg = LPH_NO_VIRTUALIZE(function(HitPartCfg)
	local PerWeapon = HitPartCfg and HitPartCfg['Per Weapon'];
	if not PerWeapon or not PerWeapon['Enabled'] then return nil end;

	local MyChar = LocalPlayer.Character;
	if not MyChar then return nil end;
	local Tool = MyChar:FindFirstChildOfClass('Tool');
	if not Tool then return nil end;
	local ToolName = Tool.Name;

	for _, Category in next, PerWeaponCategories do
		local CatCfg = PerWeapon[Category];
		if not CatCfg then continue end;
		local Weapons = CatCfg['Weapons'];
		if not Weapons then continue end;
		for _, WeaponName in next, Weapons do
			if WeaponName == ToolName then
				return CatCfg;
			end;
		end;
	end;

	return nil;
end);

local ResolveHitFromCfg = LPH_NO_VIRTUALIZE(function(TargetChar, HitPartMode, NpCfg, MultiCfg, NamedPart)
	if HitPartMode == 'Multi' and MultiCfg and MultiCfg['Enabled'] then
		local Pos, Part = ResolveMultiPart(TargetChar, MultiCfg);
		if Pos then return Pos, Part end;
	end;

	if HitPartMode == 'Named Part' then
		local PartName = NamedPart or 'HumanoidRootPart';
		local Part = TargetChar:FindFirstChild(PartName);
		if Part then return Part.Position, Part end;

	elseif HitPartMode == 'Nearest Part' then
		local Part = GetClosestPartToCursor(TargetChar);
		if Part then return Part.Position, Part end;

	elseif HitPartMode == 'Nearest Point' then
		local Part = GetClosestPartToCursor(TargetChar);
		if Part then
			local Plane = NpCfg and NpCfg['Plane'] or 'Vertical';
			local OffsetKey = Plane == 'Vertical' and 'Vertical' or 'Full';
			local Offset = NpCfg and NpCfg['Offset'] and NpCfg['Offset'][OffsetKey] or 0.7;
			local Precision = NpCfg and NpCfg['Precision'] or 1;
			local Point = GetNearestPointOnPart(Part, Plane, Offset);
			if Precision < 1 then
				Point = Part.Position:Lerp(Point, Precision);
			end;
			return Point, Part;
		end;

	else
		local Part = TargetChar:FindFirstChild(HitPartMode);
		if Part then return Part.Position, Part end;
	end;

	return nil, nil;
end);

local ResolveHitPosition = LPH_NO_VIRTUALIZE(function(TargetChar, FeatureCfg)
	local HitPartCfg = FeatureCfg['Hit Part'];

	-- support both old string format and new table format
	local HitPartMode, OverrideCfg, NpCfg, MultiCfg;
	if type(HitPartCfg) == 'table' then
		HitPartMode = HitPartCfg['Selection'] or 'Nearest Point';
		OverrideCfg = HitPartCfg['Override'];
		NpCfg = HitPartCfg['Nearest Point'];
		MultiCfg = HitPartCfg['Multi'];
	else
		HitPartMode = HitPartCfg or 'Nearest Point';
		OverrideCfg = FeatureCfg['Hit Part Override'];
		NpCfg = FeatureCfg['Nearest Point'];
	end;

	if OverrideCfg and OverrideCfg['Enabled'] then
		local PartName = OverrideCfg['Part'] or 'Head';
		local Part = TargetChar:FindFirstChild(PartName);
		if Part then return Part.Position, Part end;
	end;

	local PwCfg = ResolvePerWeaponCfg(HitPartCfg);
	if PwCfg then
		local PwMode = PwCfg['Selection'] or 'Nearest Point';
		local PwNp = PwCfg['Nearest Point'];
		local PwMulti = PwCfg['Multi'];
		local PwNamed = PwCfg['Named Part'];
		local Pos, Part = ResolveHitFromCfg(TargetChar, PwMode, PwNp, PwMulti, PwNamed);
		if Pos then return Pos, Part end;
	end;

	local NamedPart = (type(HitPartCfg) == 'table' and HitPartCfg['Named Part']) or (OverrideCfg and OverrideCfg['Part']);
	local Pos, Part = ResolveHitFromCfg(TargetChar, HitPartMode, NpCfg, MultiCfg, NamedPart);
	if Pos then return Pos, Part end;

	local Fallback = TargetChar:FindFirstChild('HumanoidRootPart');
	if Fallback then return Fallback.Position, Fallback end;
	return nil, nil;
end);

local GetAimPosition = LPH_NO_VIRTUALIZE(function(MuzzlePos, Range)
	local SilentCfg = Config['Silent Aim'];
	if SilentCfg['Enabled'] and State.Targets.Silent and PassesConditions(State.Targets.Silent) then
		local Target = State.Targets.Silent;
		local TargetChar = Target.Character;
		if TargetChar then
			local HumanoidRootPart = TargetChar:FindFirstChild('HumanoidRootPart');
			if HumanoidRootPart then
				local CurrentCamera = Workspace.CurrentCamera;
				local MaxRange = SilentCfg['Max Range'];
				if MaxRange and MaxRange < MathHuge then
					local WorldDist = (CurrentCamera.CFrame.Position - HumanoidRootPart.Position).Magnitude;
					if WorldDist > MaxRange then return Mouse.Hit.Position end;
				end;
				local ScreenPos, OnScreen = CurrentCamera:WorldToViewportPoint(HumanoidRootPart.Position);
				if OnScreen and ScreenPos.Z > 1 then
					local MousePosition = UserInputService:GetMouseLocation();
					local ViewportY = CurrentCamera.ViewportSize.Y;
					local CamFOV = CurrentCamera.FieldOfView;
					local ScaleFactor = (HumanoidRootPart.Size.Y * ViewportY) / (ScreenPos.Z * 2) * 80 / CamFOV;
					local W = (SilentCfg['FOV']['Size']['Width'] or 150) * ScaleFactor;
					local H = (SilentCfg['FOV']['Size']['Height'] or 150) * ScaleFactor;
					local Delta = Vector2New(ScreenPos.X, ScreenPos.Y) - MousePosition;
					local InBox = (not SilentCfg['FOV']['Enabled']) or (MathAbs(Delta.X) <= W / 2 and MathAbs(Delta.Y) <= H / 2);

					if InBox then
						local HitChanceCfg = SilentCfg['Hit Chance'];
						if HitChanceCfg and HitChanceCfg[1] == true then
							local Roll = MathRandom(1, 100);
							if Roll > (HitChanceCfg[2] or 100) then
								return Mouse.Hit.Position;
							end;
						end;

						local TargetPos, _ = ResolveHitPosition(TargetChar, SilentCfg);
						if not TargetPos then TargetPos = HumanoidRootPart.Position end;

						TargetPos = ApplyPrediction(TargetPos, Target, SilentCfg);
						return TargetPos;
					end;
				end;
			end;
		end;
	end;
	return Mouse.Hit.Position;
end);

