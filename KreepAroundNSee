	if not RootPart then return Position end;

	local PredCfg = FeatureCfg['Prediction'];
	if not PredCfg or PredCfg[1] ~= true then return Position end;

	local Vel = GetDeltaVelocity(Target);
	local PredValue = PredCfg[2] or 0.13;
	local OverrideY = FeatureCfg['Override Y Axis'] or 'None';
	local PredY = PredValue;

	if OverrideY == 'Full' then
		PredY = 0;
	elseif OverrideY == 'Half' then
		PredY = PredValue * 0.5;
	end;

	local YPred = FeatureCfg['Custom Y Prediction'];
	if YPred and YPred['Enabled'] then
		local Humanoid = Character:FindFirstChildOfClass('Humanoid');
		if Humanoid then
			local InAir = Humanoid.FloorMaterial == EnumAir;
			if InAir then
				local HState = Humanoid:GetState();
				if HState == EnumJumping then
					PredY = YPred['Jumping']['Value'] or 0.2;
				else
					local FallVal = YPred['Falling']['Value'] or 0.2;
					PredY = FallVal / 4.8;
				end;
			end;
		end;
	end;

	return Position + Vel * Vector3New(PredValue, PredY, PredValue);
end);

